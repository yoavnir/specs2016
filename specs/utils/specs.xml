    <!-- Output placement. next down to "n", nextword down to "nextw"
         (plus nw and nword), nextfield down to "nextf" (plus nf and
         nfield). A trailing ".len" is highlighted separately. -->
    <list name="placement">
      <item>n</item>
      <item>ne</item>
      <item>nex</item>
      <item>next</item>
      <item>nw</item>
      <item>nword</item>
