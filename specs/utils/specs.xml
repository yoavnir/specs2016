<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language>
<!--
    KDE-style syntax definition for the "specs" specification language.

    specs is an implementation of the CMS Pipelines "spec" stage:
    https://github.com/yoavnir/specs2016

    This file works with anything that reads the KDE/Kate syntax format:
      * Kate, KWrite, KDevelop and other KSyntaxHighlighting consumers
        (copy to ~/.local/share/org.kde.syntax-highlighting/syntax/)
      * skylighting, and therefore pandoc, through its
        "syntax-definition" option
      * any other consumer of the KDE highlighting XML format

    It is deliberately self-contained: it contains no IncludeRules references
    to other syntax files (no "##Comments", "##Alerts", etc.), so a single
    syntax-definition option is enough to load it.

    Maintenance: the keyword lists below are derived from the specs sources.
    When any of these change, update this file as well:
      * spec unit keywords and their abbreviations
            specs/src/cli/tokens.cc  (SIMPLETOKEN / SIMPLETOKENV / the
                                      NEXTWORD / NEXTFIELD / NEXT block)
      * conversions
            specs/src/processing/conversions.h  (STRING_CONVERSIONS_LIST and
                                                 PARAMETRIZED_CONVERSIONS_LIST)
      * ALU function names
            specs/src/utils/aluFunctions.h  (ALU_FUNCTION_LIST)

    SPDX-FileCopyrightText: 2018-2026 Yoav Nir
    SPDX-License-Identifier: MIT
 -->
<language
    name="specs"
    section="Scripts"
    version="1"
    kateversion="5.79"
    extensions="*.spec;*.specs"
    mimetype="text/x-specs"
    casesensitive="0"
    license="MIT"
  >
  <highlighting>

    <!-- Main options. Only valid at the very start of a specification.
         PRINTONLY is not here: it takes an argument, so it has its own
         rule in the Normal context. -->
    <list name="mainoptions">
      <item>stop</item>
      <item>alleof</item>
      <item>anyeof</item>
      <item>keep</item>
      <item>counters</item>
      <item>eof</item>
    </list>

    <!-- Flow control, following the grouping of chapter 10 of the guidebook.
         Some of these are matched by rules of their own in the Normal
         context rather than by this list, because they take an argument the
         rule has to switch context for: IF, ELSEIF, WHILE, ASSERT, ABEND,
         SKIP-UNTIL and SKIP-WHILE take an ALU expression, and BREAK takes a
         field identifier. They are listed here anyway so that this list
         stays the full picture. -->
    <list name="controlflow">
      <item>if</item>
      <item>then</item>
      <item>else</item>
      <item>elseif</item>
      <item>endif</item>
      <item>while</item>
      <item>do</item>
