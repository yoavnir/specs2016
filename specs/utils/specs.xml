    <list name="alufunctions">
      <item>abbrev</item>
      <item>abs</item>
      <item>arccos</item>
      <item>arcdcos</item>
      <item>arcdsin</item>
      <item>arcdtan</item>
      <item>arcsin</item>
      <item>arctan</item>
      <item>average</item>
      <item>bitand</item>
      <item>bitor</item>
      <item>bitxor</item>
      <item>break</item>
      <item>bswap</item>
      <item>c2d</item>
      <item>c2f</item>
      <item>c2u</item>
      <item>c2x</item>
      <item>ceil</item>
      <item>center</item>
      <item>centre</item>
      <item>cfrecord</item>
      <item>combinations</item>
      <item>compare</item>
      <item>conf</item>
      <item>copies</item>
      <item>cos</item>
      <item>countocc</item>
      <item>countocc_dump</item>
      <item>countocc_get</item>
      <item>ctxoffset</item>
