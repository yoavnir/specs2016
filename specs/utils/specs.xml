    <list name="alignment">
      <item>left</item>
      <item>right</item>
      <item>center</item>
      <item>centre</item>
    </list>

    <!-- Conversions. "identity" is deliberately absent: it is excluded by
         getConversionByName(), so in a specification it is just a literal.
         "b2x" is also absent: it appears in the documentation but is not
         implemented. The six parametrized conversions take a format
         string as their next token. -->
    <list name="conversions">
      <item>ROT13</item>
      <item>C2B</item>
      <item>C2X</item>
      <item>B2C</item>
      <item>X2CH</item>
      <item>D2X</item>
      <item>X2D</item>
