    <contexts>

      <!-- The order of the rules in this context mirrors the order in
           which parseSingleToken() in tokens.cc tries to interpret a
           token, so that ambiguous spellings resolve the same way. -->
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces />

        <!-- A comment starts at the *last* "# " on the line (removeComment()
             in splitter.cc uses rfind), so an earlier "# " is code. The
             negative lookahead reproduces that: this "#" only starts a
             comment when no later " # " follows. A "#" that is the very
             last character on the line also starts a comment; a "#" not
             followed by a blank (as in the #0 counter) never does. -->
        <RegExpr attribute="Comment" context="Comment" String="#(?= )(?!.*\s# )" />
        <RegExpr attribute="Comment" context="Comment" String="#$" />

        <!-- Directives. Only valid on their own line, before any spec text. -->
        <RegExpr attribute="Directive" context="DirectiveSet" String="^\+SET\b" insensitive="false" />
        <RegExpr attribute="Directive" context="DirectiveCmd" String="^\+IN\b" insensitive="false" />

        <!-- The splitter honours a backslash escape anywhere. -->
        <RegExpr attribute="Escape" context="#stay" String="\\." />

        <!-- Delimited literals. Any of ' " / may be used as the delimiter. -->
        <DetectChar attribute="String" context="StringDQ" char="&quot;" />
        <DetectChar attribute="String" context="StringSQ" char="'" />
        <DetectChar attribute="String" context="StringSlash" char="/" />

        <!-- Configured literals and record pseudo-variables. -->
	<RegExpr attribute="Label" context="#stay" String="@@|@!|@>|@[-+]\d{1,3}|@[A-Za-z_][A-Za-z0-9_-]*" />

        <!-- Counters (#0 - #999). The #name form of a persistent variable
             is only meaningful inside an expression, so it is highlighted
             there and left alone here. -->
        <RegExpr attribute="Counter" context="#stay" String="#\d{1,3}(?=\s|$)" />

        <!-- Field identifier, either capturing input ("a: 1-5") or
             capturing output ("1-5 a:"). Exactly one letter and a colon. -->
        <RegExpr attribute="Field Identifier" context="#stay" String="[A-Za-z]:(?=\s|$)" />

        <!-- Conversions come before the hex literal rule on purpose: "x2d"
             is both a valid conversion and a valid hex literal, and
             tokens.cc tries conversions first. -->
        <keyword attribute="Conversion" context="#stay" String="conversions" />

        <!-- Hex literal: a lowercase x and an even number of hex digits.
             An uppercase X is not accepted by the tokenizer. -->
        <RegExpr attribute="Hex" context="#stay" String="x([0-9A-Fa-f]{2})+(?=\s|$)" insensitive="false" />

        <!-- Separator and pad settings swallow the following character,
             which may be a bare character, a quoted one, or "default". -->
        <RegExpr attribute="Separator" context="SepChar" String="(ws|fs|pad|wordsep(a(r(a(t(o(r)?)?)?)?)?)?|fieldsep(a(r(a(t(o(r)?)?)?)?)?)?)(?=\s|$)" insensitive="true" />

        <!-- Keywords whose argument is a one-letter field identifier.
             PRINTONLY also accepts EOF. -->
        <RegExpr attribute="Input Source" context="FidArg" String="id(?=\s|$)" insensitive="true" />
        <RegExpr attribute="Control Flow" context="FidArg" String="break(?=\s|$)" insensitive="true" />
        <RegExpr attribute="Main Option" context="FidArg" String="printonly(?=\s|$)" insensitive="true" />

        <!-- Keywords taking an ALU expression as their argument. The flow
             control ones are in the "controlflow" list too, but need these
             rules, ahead of that list, to switch into the expression.
             PRINT also has the "?" spelling, which may be a token of its
             own or a prefix of the expression. -->
        <RegExpr attribute="Control Flow" context="ExprArg" String="(elseif|if|while|assert|abend|skip-until|skip-while)(?=\s|$)" />
        <RegExpr attribute="Keyword" context="ExprArg" String="(set)(?=\s|$)" />
        <RegExpr attribute="Input Source" context="ExprArg" String="(print)(?=\s|$)" />
        <RegExpr attribute="Input Source" context="ExprArg" String="\?" />

        <keyword attribute="Main Option" context="#stay" String="mainoptions" />
        <keyword attribute="Control Flow" context="#stay" String="controlflow" />
        <keyword attribute="IO Keyword" context="#stay" String="io" />
        <keyword attribute="Input Source" context="#stay" String="inputsource" />
        <keyword attribute="Placement" context="#stay" String="placement" />
        <keyword attribute="Alignment" context="#stay" String="alignment" />

        <!-- Input and output ranges: 5, -1, 3-7, 3;7, 3:7, 1-*, 5.8,
             and the same forms prefixed with w or f. -->
        <RegExpr attribute="Range" context="#stay" String="[wWfF]?-?\d+([-;:](\d+|\*)|\.\d+)?(?=\s|$|\)|,)" />

        <!-- The ".len" suffix of nw.8 / next.5, and the lone period
             meaning "produce no output". -->
        <RegExpr attribute="Range" context="#stay" String="\.\d+(?=\s|$|\)|,)" />
        <RegExpr attribute="Placement" context="#stay" String="\.(?=\s|$)" />

        <!-- Groups of input ranges, and composed output placement. -->
        <AnyChar attribute="Operator" context="#stay" String="()," />

        <!-- Anything else is a literal. Consuming the whole token keeps the
             comment rules above from firing on a "#" inside a token, which
             the real tokenizer would not treat as a comment either. -->
        <RegExpr attribute="Normal Text" context="#stay" String="\S+" />
      </context>

      <context name="Comment" attribute="Comment" lineEndContext="#pop" />

      <!-- "+SET name shell command" -->
      <context name="DirectiveSet" attribute="Normal Text" lineEndContext="#pop">
        <DetectSpaces />
        <RegExpr attribute="Variable" context="DirectiveSetCmd" String="\S+" />
      </context>
      <context name="DirectiveSetCmd" attribute="Shell Command" lineEndContext="#pop#pop" />

      <!-- "+IN shell command" -->
      <context name="DirectiveCmd" attribute="Shell Command" lineEndContext="#pop" />

      <!-- The one-letter field identifier argument of ID / BREAK / PRINTONLY. -->
      <context name="FidArg" attribute="Normal Text" lineEndContext="#pop">
        <DetectSpaces />
        <RegExpr attribute="Main Option" context="#pop" String="eof(?=\s|$)" />
        <RegExpr attribute="Field Identifier" context="#pop" String="[A-Za-z](?=\s|$)" />
        <RegExpr attribute="Normal Text" context="#pop" String="\S" lookAhead="true" />
      </context>

      <!-- The character argument of WS / FS / PAD. -->
      <context name="SepChar" attribute="Normal Text" lineEndContext="#pop">
        <DetectSpaces />
        <!-- The tokenizer only accepts "default" in lower case here. -->
        <StringDetect attribute="Keyword" context="#pop" String="default" insensitive="false" />
        <RegExpr attribute="Separator Char" context="#pop" String="&quot;.&quot;|'.'|/./|\\?." />
      </context>

      <!-- Plain literals, with no expression highlighting. A literal may
           span lines, because parseTokensFile() joins all the lines of a
           spec file with a blank before splitting them into tokens, so
           these contexts stay open at the end of a line. An unbalanced
           delimiter therefore colours the rest of the file as a string -
           which is also what specs itself reports, as "Missing delimiter
           at end of input". -->
      <context name="StringDQ" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Escape" context="#stay" String="\\." />
        <DetectChar attribute="String" context="#pop" char="&quot;" />
      </context>
      <context name="StringSQ" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Escape" context="#stay" String="\\." />
        <DetectChar attribute="String" context="#pop" char="'" />
      </context>
      <context name="StringSlash" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Escape" context="#stay" String="\\." />
        <DetectChar attribute="String" context="#pop" char="/" />
      </context>

      <!-- The argument of PRINT / SET / IF / WHILE / ASSERT / ... is an ALU
           expression. It is usually quoted, but it may also be a bare token
           or a parenthesized group. -->
      <context name="ExprArg" attribute="Normal Text" lineEndContext="#pop">
        <DetectSpaces />
        <DetectChar attribute="String" context="ExprDQ" char="&quot;" />
        <DetectChar attribute="String" context="ExprSQ" char="'" />
        <DetectChar attribute="Operator" context="ExprParen" char="(" />
        <RegExpr attribute="Normal Text" context="ExprBare" String="\S" lookAhead="true" />
      </context>

      <context name="ExprDQ" attribute="String" lineEndContext="#stay">
        <DetectChar attribute="String" context="#pop#pop" char="&quot;" />
        <DetectChar attribute="String" context="ExprNestedSQ" char="'" />
        <IncludeRules context="ALU" />
      </context>

      <context name="ExprSQ" attribute="String" lineEndContext="#stay">
        <DetectChar attribute="String" context="#pop#pop" char="'" />
        <DetectChar attribute="String" context="ExprNestedDQ" char="&quot;" />
        <IncludeRules context="ALU" />
      </context>

      <!-- A quoted string inside an expression, as in
           print "substitute(@@,XXDATE,#0,'U')" -->
      <context name="ExprNestedSQ" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Escape" context="#stay" String="\\." />
        <DetectChar attribute="String" context="#pop" char="'" />
      </context>
      <context name="ExprNestedDQ" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Escape" context="#stay" String="\\." />
        <DetectChar attribute="String" context="#pop" char="&quot;" />
      </context>

      <context name="ExprParen" attribute="Normal Text" lineEndContext="#stay">
        <DetectChar attribute="Operator" context="#pop#pop" char=")" />
        <DetectChar attribute="Operator" context="ExprParenNested" char="(" />
        <DetectChar attribute="String" context="ExprNestedDQ" char="&quot;" />
        <DetectChar attribute="String" context="ExprNestedSQ" char="'" />
        <IncludeRules context="ALU" />
      </context>

      <context name="ExprParenNested" attribute="Normal Text" lineEndContext="#stay">
        <DetectChar attribute="Operator" context="#pop" char=")" />
        <DetectChar attribute="Operator" context="ExprParenNested" char="(" />
        <DetectChar attribute="String" context="ExprNestedDQ" char="&quot;" />
        <DetectChar attribute="String" context="ExprNestedSQ" char="'" />
        <IncludeRules context="ALU" />
      </context>

      <!-- An unquoted expression, as in "?2+2" or "print #0". It ends at
           the first blank, just as the splitter ends the token there. -->
      <context name="ExprBare" attribute="Normal Text" lineEndContext="#pop#pop">
        <DetectSpaces attribute="Normal Text" context="#pop#pop" />
        <DetectChar attribute="String" context="ExprNestedDQ" char="&quot;" />
        <DetectChar attribute="String" context="ExprNestedSQ" char="'" />
        <IncludeRules context="ALU" />
      </context>

      <!-- Rules shared by every expression context. Not entered directly. -->
      <context name="ALU" attribute="Normal Text" lineEndContext="#stay">
        <RegExpr attribute="Escape" context="#stay" String="\\." />
        <keyword attribute="Function" context="#stay" String="alufunctions" />
        <RegExpr attribute="Function" context="#stay" String="[A-Za-z_][A-Za-z0-9_]+(?=\s*\()" />
	<RegExpr attribute="Label" context="#stay" String="@@|@!|@>|@[-+]\d{1,3}|@[A-Za-z_][A-Za-z0-9_]*" />
        <RegExpr attribute="Counter" context="#stay" String="#\d{1,3}|#[A-Za-z_][A-Za-z0-9_]*" />
        <RegExpr attribute="Number" context="#stay" String="\d+(\.\d+)?|\.\d+" />
        <RegExpr attribute="Field Identifier" context="#stay" String="[A-Za-z](?![A-Za-z0-9_])" />
        <!-- The lexer takes a maximal run of these characters as a single
             operator, so + - * / // % || < <= << <<= = == != !== &amp; | := += ...
             are all matched here. -->
        <RegExpr attribute="Operator" context="#stay" String="[-+*/|!&lt;&gt;:&amp;%=]+" />
        <AnyChar attribute="Operator" context="#stay" String="()," />
      </context>

    </contexts>

    <itemDatas>
      <itemData name="Normal Text"      defStyleNum="dsNormal" />
      <itemData name="Comment"          defStyleNum="dsComment" />
      <itemData name="Directive"        defStyleNum="dsPreprocessor" spellChecking="0" />
      <itemData name="Shell Command"    defStyleNum="dsOthers" spellChecking="0" />
      <itemData name="Main Option"      defStyleNum="dsAttribute" spellChecking="0" />
      <itemData name="Keyword"          defStyleNum="dsKeyword" spellChecking="0" />
      <itemData name="Control Flow"     defStyleNum="dsControlFlow" spellChecking="0" />
      <itemData name="IO Keyword"       defStyleNum="dsKeyword" spellChecking="0" />
      <itemData name="Input Source"     defStyleNum="dsBuiltIn" spellChecking="0" />
      <!-- Placement, Alignment and Conversion deliberately share dsDataType:
           they are the three parts of a data field that follow its input
           part, and are meant to read as one group. -->
      <itemData name="Placement"        defStyleNum="dsDataType" spellChecking="0" />
      <itemData name="Alignment"        defStyleNum="dsDataType" spellChecking="0" />
      <itemData name="Separator"        defStyleNum="dsKeyword" spellChecking="0" />
      <itemData name="Separator Char"   defStyleNum="dsChar" spellChecking="0" />
      <itemData name="Conversion"       defStyleNum="dsDataType" spellChecking="0" />
      <itemData name="Range"            defStyleNum="dsDecVal" spellChecking="0" />
      <itemData name="Field Identifier" defStyleNum="dsVariable" spellChecking="0" />
      <itemData name="Counter"          defStyleNum="dsVariable" spellChecking="0" />
