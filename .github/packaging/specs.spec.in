Name:           specs
Version:        @VERSION@
Release:        1
Summary:        A command-line utility for parsing and re-arranging text input
License:        MIT
URL:            https://github.com/yoavnir/specs2016
Source0:        specs-%{version}.tar.gz

%description
specs is a command line utility for parsing and re-arranging text input.
It allows re-alignment of fields, some format conversion, and re-formatting
multiple lines into single lines or vice versa.

%prep
%setup -q

%install
mkdir -p %{buildroot}/usr/local/bin
mkdir -p %{buildroot}/usr/local/share/man/man1
install -m 755 specs %{buildroot}/usr/local/bin/specs
install -m 755 specs-autocomplete %{buildroot}/usr/local/bin/specs-autocomplete
install -m 644 specs.1.gz %{buildroot}/usr/local/share/man/man1/specs.1.gz

%files
/usr/local/bin/specs
/usr/local/bin/specs-autocomplete
/usr/local/share/man/man1/specs.1.gz
